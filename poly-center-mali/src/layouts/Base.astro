---
import '../styles/global.css';
import PromoBanner from '../components/PromoBanner.astro';
import { site, reseaux, nav, technique, gestion } from '../data/site.js';
const { title, description = site.baseline } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const cur = (h) => (h === path ? 'page' : undefined);
const wa = `https://wa.me/${site.whatsapp}`;
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} | {site.nom}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={`${title} | ${site.nom}`} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content="/logo/logo-original.jpg" />
  <meta name="theme-color" content="#10194a" />
  <script is:inline>document.documentElement.classList.add("js")</script>
  <link rel="icon" href="/favicon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;600;700&family=Barlow+Condensed:wght@700;800&display=swap" rel="stylesheet" />
</head>
<body>
  <header><div class="wrap bar">
    <a class="brand" href="/"><img src="/logo/icon.png" alt="" />{site.nom}</a>
    <nav class="top" aria-label="Navigation principale">
      {nav.map((n) => <a href={n.href} aria-current={cur(n.href)}>{n.label}</a>)}
    </nav>
    <a class="btn" href="/contact">Demander un devis</a>
    <button class="burger" aria-label="Menu" aria-expanded="false">☰</button>
  </div></header>
  <PromoBanner />
  <dialog id="lb" class="lb"><button class="x" data-close aria-label="Fermer">×</button><img alt="" /></dialog>
  <main><slot /></main>
  <footer><div class="wrap">
    <div class="fcols">
      <div><h4>{site.nom}</h4><p>{site.baseline}.</p></div>
      <div><h4>Navigation</h4><ul>{nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul></div>
      <div><h4>Nos services</h4><ul>{[...technique, ...gestion].map((s) => <li><a href="/services">{s.t}</a></li>)}</ul></div>
      <div><h4>Contact</h4><ul>
        {site.telephones.map((t) => <li><a href={`tel:${t.replace(/\s/g, '')}`}>{t}</a></li>)}
        <li><a href={wa}>WhatsApp</a></li>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li>{site.adresse}</li></ul>
        <div class="social">{reseaux.filter((r) => r.url).map((r) => <a href={r.url} target="_blank" rel="noopener">{r.nom}</a>)}</div></div>
    </div>
    <p class="copy">© {new Date().getFullYear()} {site.nom}. Tous droits réservés.</p>
  </div></footer>
  <nav class="tabs" aria-label="Navigation mobile">
    <a href="/" aria-current={cur('/')}>Accueil</a>
    <a href="/services" aria-current={cur('/services')}>Services</a>
    <a href="/formations" aria-current={cur('/formations')}>Formations</a>
    <a href="/equipe" aria-current={cur('/equipe')}>Équipe</a>
    <a class="go" href={wa}>WhatsApp</a>
  </nav>
<script>
  const io = new IntersectionObserver((es) => es.forEach((e) => {
    if (!e.isIntersecting) return;
    const el = e.target; el.classList.add('in'); io.unobserve(el);
    setTimeout(() => el.classList.add('done'), 1600);
  }), { threshold: 0.12 });
  document.querySelectorAll('.rv').forEach((el) => io.observe(el));

  document.querySelectorAll('[data-open]').forEach((b) => b.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) return; (document.getElementById((b as HTMLElement).dataset.open!) as HTMLDialogElement)?.showModal(); }));
  document.querySelectorAll('dialog').forEach((d) => {
    d.addEventListener('click', (e) => { if (e.target === d || (e.target as HTMLElement).hasAttribute('data-close')) d.close(); });
  });
  const lb = document.getElementById('lb') as HTMLDialogElement | null;
  document.querySelectorAll('[data-zoom]').forEach((i) => i.addEventListener('click', () => {
    if (!lb) return; const im = lb.querySelector('img')!; im.src = (i as HTMLImageElement).src; im.alt = (i as HTMLImageElement).alt; lb.showModal();
  }));

  const bg = document.querySelector('.burger'), nv = document.querySelector('nav.top');
  bg?.addEventListener('click', () => { const o = nv?.classList.toggle('open'); bg.setAttribute('aria-expanded', String(!!o)); });

  const l = document.getElementById('logo');
  l?.addEventListener('click', () => l.querySelectorAll('img').forEach((i) => { i.style.animation = 'none'; void i.offsetWidth; i.style.animation = ''; }));

  document.querySelectorAll('[data-slider]').forEach((s) => {
    const imgs = [...s.querySelectorAll('img')], dots = [...s.querySelectorAll('.dots button')];
    if (imgs.length < 2) return;
    let k = 0, t: any;
    const show = (n: number) => { k = n; imgs.forEach((im, j) => im.classList.toggle('on', j === k)); dots.forEach((d, j) => d.classList.toggle('on', j === k)); };
    const run = () => { clearInterval(t); t = setInterval(() => show((k + 1) % imgs.length), 3800); };
    dots.forEach((d, j) => d.addEventListener('click', () => { show(j); run(); }));
    run();
  });
</script>
</body>
</html>
