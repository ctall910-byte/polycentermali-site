---
import Icon from './Icon.astro';
import { site } from '../data/site.js';
import { services } from '../data/services.js';
const wa = (s) => `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(`Bonjour, je souhaite réserver le service « ${s.t} ».`)}`;
---
<div class="grid fgrid">
  {services.map((s, i) => (
    <article class="card fcard rv" style={`--i:${i % 4}`} data-cat={s.cat} data-open={`s-${s.id}`} >
      {s.image ? <div class="fphoto"><img src={s.imagePath + s.image} alt={s.t} loading="lazy" /></div> : <div class="ill small"><Icon name={s.icon} size={84} /></div>}
      <h3>{s.t}</h3>
      <p>{s.d}</p>
      <div class="facts">
        <button class="more" type="button" aria-haspopup="dialog">Voir les détails <b>→</b></button>
        <a class="btn mini" href={wa(s)} target="_blank" rel="noopener">Réserver</a>
      </div>
    </article>
  ))}
</div>
{services.map((s) => (
  <dialog id={`s-${s.id}`} class="dlg" aria-label={s.t}>
    <button class="x" data-close aria-label="Fermer">×</button>
    <div class="dhead"><div class="ill small"><Icon name={s.icon} size={70} /></div><div><span class="pill">Service</span><h2>{s.t}</h2></div></div>
    <p class="lead">{s.d}</p>
    <dl class="info">
      <div><dt>Délai</dt><dd>{s.delai}</dd></div>
      <div><dt>Lieu</dt><dd>Chez vous ou dans nos locaux, selon le service</dd></div>
    </dl>
    <p class="note">Le devis est établi gratuitement après étude de votre besoin.</p>
    <div class="two">
      <div><h4>Ce que nous faisons</h4><ul class="ticks">{s.inclus.map((o) => <li>{o}</li>)}</ul></div>
      <div><h4>Comment ça se passe</h4><ul class="ticks">{s.etapes.map((o) => <li>{o}</li>)}</ul></div>
    </div>
    <div class="cta-row"><a class="btn" href={wa(s)} target="_blank" rel="noopener">Réserver sur WhatsApp</a><a class="btn alt" href="/contact">Nous contacter</a></div>
  </dialog>
))}
