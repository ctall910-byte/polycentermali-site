---
const { name, size = 64 } = Astro.props;
const N = '#10194a', O = '#ee7b1e';
---
<svg viewBox="0 0 64 64" width={size} height={size} aria-hidden="true" class={`ico ico-${name}`}>
  {name === 'solar' && <>
    <g class="rays" stroke={O} stroke-width="4" stroke-linecap="round"><path d="M32 16V7M43.3 20.7l6.4-6.4M48 32h9M43.3 43.3l6.4 6.4M32 48v9M20.7 43.3l-6.4 6.4M16 32H7M20.7 20.7l-6.4-6.4"/></g>
    <circle cx="32" cy="32" r="12" fill={O}/><polygon points="34,24 27,34 32,34 30,41 38,30 33,30" fill={N}/></>}
  {name === 'chart' && <>
    <rect class="bar b1" x="9" y="38" width="12" height="18" rx="2" fill={O}/><rect class="bar b2" x="26" y="26" width="12" height="30" rx="2" fill={N}/><rect class="bar b3" x="43" y="12" width="12" height="44" rx="2" fill={O}/>
    <path d="M6 58h52" stroke={N} stroke-width="3" stroke-linecap="round"/></>}
  {name === 'cap' && <>
    <path d="M16 34v10c10 8 22 8 32 0V34l-16 8z" fill={O}/><polygon points="32,10 60,24 32,38 4,24" fill={N}/>
    <path d="M56 26v16" stroke={O} stroke-width="3" stroke-linecap="round"/><circle cx="56" cy="45" r="3.5" fill={O}/></>}
  {name === 'rocket' && <>
    <path class="flame" d="M28 44l4 16 4-16z" fill={O}/><path d="M24 36L12 48l12-2zM40 36l12 12-12-2z" fill={O}/>
    <path d="M32 4c11 8 13 24 8 38H24C19 28 21 12 32 4z" fill={N}/><circle cx="32" cy="24" r="5" fill={O}/></>}
  {name === 'calc' && <>
    <rect x="12" y="6" width="40" height="52" rx="7" fill={N}/><rect x="18" y="12" width="28" height="12" rx="3" fill="#fff"/>
    <g fill="#fff"><circle cx="23" cy="33" r="3"/><circle cx="32" cy="33" r="3"/><circle cx="41" cy="33" r="3"/><circle cx="23" cy="42" r="3"/><circle cx="32" cy="42" r="3"/><circle cx="23" cy="51" r="3"/><circle cx="32" cy="51" r="3"/></g>
    <circle cx="41" cy="42" r="3" fill={O}/><rect x="38" y="48" width="6" height="6" rx="3" fill={O}/></>}
  {name === 'mic' && <>
    <rect x="23" y="5" width="18" height="30" rx="9" fill={N}/><path d="M15 29a17 17 0 0 0 34 0" fill="none" stroke={O} stroke-width="4" stroke-linecap="round"/>
    <path d="M32 46v10M22 57h20" stroke={N} stroke-width="4" stroke-linecap="round"/></>}
  {name === 'shield' && <>
    <path d="M32 5l22 8v17c0 14-10 24-22 28C20 54 10 44 10 30V13z" fill={N}/><path d="M21 31l8 8 15-16" fill="none" stroke={O} stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/></>}
  {name === 'bolt' && <>
    <circle cx="32" cy="32" r="27" fill={O} opacity=".22"/><polygon points="37,4 13,36 29,36 25,60 51,26 35,26" fill={N}/><polygon points="33,16 24,32 34,32 31,44 42,28 33,28" fill={O}/></>}
  {name === 'monitor' && <>
    <rect x="5" y="9" width="54" height="36" rx="5" fill={N}/><rect x="10" y="14" width="44" height="26" rx="2" fill="#fff"/>
    <rect x="15" y="19" width="20" height="5" rx="2" fill={O}/><rect x="15" y="28" width="30" height="3" rx="1.5" fill={N} opacity=".45"/><rect x="15" y="34" width="22" height="3" rx="1.5" fill={N} opacity=".45"/>
    <path d="M32 45v9M21 56h22" stroke={N} stroke-width="4" stroke-linecap="round"/></>}
  {name === 'chip' && <>
    <path d="M24 6v10M32 6v10M40 6v10M24 48v10M32 48v10M40 48v10M6 24h10M6 32h10M6 40h10M48 24h10M48 32h10M48 40h10" stroke={N} stroke-width="3.5" stroke-linecap="round"/>
    <rect x="14" y="14" width="36" height="36" rx="7" fill={N}/><rect x="22" y="22" width="20" height="20" rx="4" fill={O}/>
    <text x="32" y="37" text-anchor="middle" font-size="12" font-weight="800" fill="#fff" font-family="Barlow Condensed,sans-serif">IA</text></>}
  {name === 'chat' && <>
    <path d="M12 8h26a8 8 0 0 1 8 8v10a8 8 0 0 1-8 8H24l-10 8v-8h-2a8 8 0 0 1-8-8V16a8 8 0 0 1 8-8z" fill={N}/>
    <path d="M26 28h26a8 8 0 0 1 8 8v8a8 8 0 0 1-8 8h-2v7l-9-7H26a8 8 0 0 1-8-8v-8a8 8 0 0 1 8-8z" fill={O}/>
    <text x="23" y="26" text-anchor="middle" font-size="13" font-weight="800" fill="#fff" font-family="Barlow Condensed,sans-serif">Hi</text>
    <text x="40" y="47" text-anchor="middle" font-size="13" font-weight="800" fill="#fff" font-family="Barlow Condensed,sans-serif">Aa</text></>}
  {name === 'book' && <>
    <path d="M32 14C24 9 14 9 7 12v38c7-3 17-3 25 2 8-5 18-5 25-2V12c-7-3-17-3-25 2z" fill={N}/>
    <path d="M32 14v38" stroke={O} stroke-width="3"/><path d="M13 22h12M13 30h12M13 38h12" stroke="#fff" stroke-width="3" stroke-linecap="round"/>
    <path d="M39 22h12M39 30h12" stroke="#fff" stroke-width="3" stroke-linecap="round"/><rect x="39" y="36" width="12" height="7" rx="2" fill={O}/></>}
  {name === 'megaphone' && <>
    <path d="M8 24h12l24-13v38L20 38H8z" fill={N}/><rect x="13" y="38" width="9" height="15" rx="3" fill={O}/>
    <path d="M50 22q7 10 0 20M56 14q12 18 0 36" fill="none" stroke={O} stroke-width="4" stroke-linecap="round"/></>}
  {name === 'coin' && <>
    <circle cx="32" cy="32" r="26" fill={O}/><circle cx="32" cy="32" r="19" fill="none" stroke={N} stroke-width="3"/>
    <text x="32" y="42" text-anchor="middle" font-size="28" font-weight="800" fill={N} font-family="Barlow Condensed,sans-serif">F</text></>}
  {name === 'crown' && <>
    <path d="M7 46L5 20l14 12 13-19 13 19 14-12-2 26z" fill={N}/><rect x="7" y="49" width="50" height="8" rx="3" fill={O}/>
    <circle cx="5" cy="18" r="4" fill={O}/><circle cx="32" cy="11" r="4" fill={O}/><circle cx="59" cy="18" r="4" fill={O}/></>}
  {name === 'leaf' && <>
    <path d="M10 54C8 28 25 10 56 8c2 30-11 48-36 48z" fill={O}/><path d="M10 54L42 22M24 40l-1-12M34 31l-1-13" stroke={N} stroke-width="3.5" stroke-linecap="round" fill="none"/></>}
  {name === 'medal' && <>
    <rect x="6" y="8" width="46" height="36" rx="5" fill="#fff" stroke={N} stroke-width="3"/><path d="M13 17h26M13 24h20M13 31h14" stroke={N} stroke-width="3" stroke-linecap="round"/>
    <path d="M40 46l-5 14 9-4 9 4-5-14z" fill={N}/><circle cx="44" cy="40" r="11" fill={O}/><path d="M39 40l4 4 7-8" stroke="#fff" stroke-width="3.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></>}
  {name === 'gear' && <g><circle cx="32" cy="32" r="22" fill="none" stroke={N} stroke-width="7" stroke-dasharray="8 8.65"/><circle cx="32" cy="32" r="17" fill={N}/><circle cx="32" cy="32" r="7" fill={O}/></g>}
  {name === 'bulb' && <>
    <circle cx="32" cy="26" r="17" fill={O}/><path d="M26 31l6-9 6 9" fill="none" stroke={N} stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
    <rect x="23" y="42" width="18" height="8" rx="2" fill={N}/><rect x="26" y="51" width="12" height="6" rx="3" fill={N}/></>}
  {name === 'clipboard' && <>
    <rect x="12" y="8" width="40" height="50" rx="5" fill={N}/><rect x="22" y="4" width="20" height="10" rx="3" fill={O}/>
    <path d="M20 26l4 4 7-8M20 40l4 4 7-8M36 28h10M36 42h10" fill="none" stroke="#fff" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/></>}
  {name === 'code' && <>
    <rect x="5" y="9" width="54" height="40" rx="5" fill={N}/><path d="M24 22l-9 9 9 9M40 22l9 9-9 9M35 19l-6 24" fill="none" stroke={O} stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M22 56h20" stroke={N} stroke-width="4" stroke-linecap="round"/></>}
  {name === 'panel' && <>
    <rect x="10" y="5" width="44" height="54" rx="5" fill={N}/><rect x="15" y="10" width="34" height="44" rx="3" fill="#fff"/>
    <g fill={N}><rect x="19" y="15" width="8" height="12" rx="1.5"/><rect x="30" y="15" width="8" height="12" rx="1.5"/><rect x="41" y="15" width="5" height="12" rx="1.5"/><rect x="19" y="33" width="8" height="12" rx="1.5"/><rect x="30" y="33" width="8" height="12" rx="1.5"/></g>
    <g fill={O}><rect x="20.500" y="17" width="5" height="4"/><rect x="31.500" y="17" width="5" height="4"/><rect x="20.500" y="39" width="5" height="4"/><rect x="31.500" y="35" width="5" height="4"/></g></>}
  {name === 'globe' && <>
    <circle cx="32" cy="32" r="25" fill={N}/><path d="M7 32h50M32 7c-13 14-13 36 0 50 13-14 13-36 0-50M12 20h40M12 44h40" fill="none" stroke="#fff" stroke-width="2.5"/><circle cx="46" cy="18" r="5" fill={O}/></>}
</svg>
